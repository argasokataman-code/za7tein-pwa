#!/bin/bash
# Sa7tein PWA — pre-commit hook
# Auto: forbidden patterns, line counts, lint, build, atlas integrity
# Setup: git config core.hooksPath .githooks

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT" || exit 1

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'
PASS=0
FAIL=0

check() {
  local name="$1"
  local cmd="$2"
  echo -e "${YELLOW}[check]${NC} $name..."
  if eval "$cmd" >/dev/null 2>&1; then
    echo -e "${GREEN}  ok${NC} $name"
    PASS=$((PASS + 1))
  else
    echo -e "${RED}  FAIL${NC} $name"
    FAIL=$((FAIL + 1))
  fi
}

echo ""
echo "======================================"
echo "  Sa7tein PWA — Pre-Commit Hook"
echo "======================================"
echo ""

# ───────────── 1. FORBIDDEN PATTERNS ─────────────
check "No dangerouslySetInnerHTML" \
  "! grep -rn 'dangerouslySetInnerHTML' src/ --include='*.tsx' --include='*.ts'"
check "No eval()/new Function()" \
  "! grep -rnE '(eval|new Function)\s*\(' src/ --include='*.tsx' --include='*.ts'"
check "No innerHTML assignments" \
  "! grep -rnE 'innerHTML\s*=' src/ --include='*.tsx' --include='*.ts'"
check "No console.log in src/" \
  "! grep -rn 'console\.log' src/ --include='*.tsx' --include='*.ts'"
check "No useAppStore hook (use useAppDispatch/useAppSelector)" \
  "! grep -rn 'useAppStore(' src/ --include='*.tsx' --include='*.ts'"
check "No foreign icon packages" \
  "! grep -rqE '(react-icons|@heroicons|@fortawesome|@tabler/icons)' package.json"
check "No external image URLs" \
  "! grep -rnE '(src|href)=[\"'\\'']https?://' src/ --include='*.tsx'"
check "SVG preserveAspectRatio not 'none'" \
  "! grep -rn 'preserveAspectRatio=\"none\"' src/ --include='*.tsx'"

# ───────────── 2. FILE LINE COUNTS ─────────────
line_check() {
  local dir="$1" glob="$2" max="$3" label="$4" exclude="$5"
  [ -d "$dir" ] || return 0
  local bad
  bad=$(find "$dir" -name "$glob" -type f ! -name "$exclude" -exec sh -c \
    'n=$(wc -l < "$1" | tr -d " "); [ "$n" -gt "$2" ] && echo "    $1 ($n > $2)"' \
    _ {} "$max" \; 2>/dev/null)
  if [ -n "$bad" ]; then
    echo -e "${RED}  FAIL${NC} $label max $max lines"
    echo "$bad"
    FAIL=$((FAIL + 1))
  else
    echo -e "${GREEN}  ok${NC} $label max $max lines"
    PASS=$((PASS + 1))
  fi
}
line_check "src/components" "*.tsx" 600 "Components" ""
line_check "src/pages" "*.tsx" 700 "Pages" "Documentation.tsx"
line_check "src/hooks" "*.ts" 150 "Hooks" ""
line_check "src/data" "*.ts" 500 "Mock data" ""

# ───────────── 3. LINT ─────────────
check "Linter (oxlint)" "npx oxlint --quiet"

# ───────────── 4. BUILD ─────────────
check "Build (tsc -b && vite build)" "npm run build"

# ───────────── 5. ATLAS INTEGRITY ─────────────
ATLAS="$HOME/.config/opencode/skills/atlas-owner/scripts/atlas.mjs"
if [ -d atlas ] && [ -f "$ATLAS" ]; then
  check "Atlas integrity" "node \"$ATLAS\" check"
fi

echo ""
echo "======================================"
echo -e "  ${GREEN}$PASS passed${NC}, ${RED}$FAIL failed${NC}"
echo "======================================"
echo ""

if [ "$FAIL" -gt 0 ]; then
  echo -e "${RED}Commit ditolak — perbaiki dulu${NC}"
  echo "Darurat: git commit --no-verify -m \"pesan\" (wajib lapor)"
  exit 1
fi

echo -e "${GREEN}Commit disetujui${NC}"
exit 0
