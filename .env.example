# Backend demo Sa7tein = Supabase PostgREST.
# Kosongkan salah satu → klien jatuh ke data mock repo (demo tetap jalan).
# Anon key memang publik (RLS yang membatasi), tapi pindahkan ke env bila
# backend berganti. Nilai default ada di src/api/supabase.ts.
VITE_SUPABASE_URL=https://dwzxtnfesmpobnepilhl.supabase.co
VITE_SUPABASE_ANON_KEY=

# Akun merchant demo — dipakai `src/api/orders.ts` untuk login saat membaca
# order (RLS `orders` butuh sesi). Ini kredensial demo publik; jangan pola ini
# di produksi (sesi nyata datang dari login user). Default ada di src/api/orders.ts.
VITE_DEMO_MERCHANT_EMAIL=merchant@sa7tein.app
VITE_DEMO_MERCHANT_PASSWORD=demo1234
VITE_DEMO_CUSTOMER_EMAIL=customer@sa7tein.app
VITE_DEMO_CUSTOMER_PASSWORD=demo1234

# Web Push (VAPID). Kunci PUBLIK aman di klien/bundle; default ada di
# src/api/push.ts. Kunci PRIVAT hanya untuk skrip pengirim dan TIDAK boleh
# ikut ter-commit — taruh di `.env.local` (di-gitignore) sebagai
# VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY, lalu:
#   npm run push:send -- --title "Pesanan siap" --body "..." --url /customer/orders
VITE_VAPID_PUBLIC_KEY=
