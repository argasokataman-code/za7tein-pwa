  "cards": [
    {
      "dot": "orange",
      "title": "Jalur A — kurir inhouse (Regular, terpasang)",
      "items": [
        "Batch hanya dari order Regular yang di-accept (BR-B01); maks 24 order (BR-B04)",
        "Assign wajib 1 kurir inhouse per batch (BR-B07); kurir menerima tanpa tolak (COU-12)",
        "Auto-sort ON = waktu tercepat, mulai merchant, akhir di order terakhir (BR-B12/B13); wajib peringatan rute WALK (beta)"
      ]
    },
    {
      "dot": "violet",
      "title": "Jalur B — kurir partner (Quick, M6 belum ada)",
      "items": [
        "Satu order per waktu; status offline / available / ter-reserve / busy (COU-15)",
        "Approve atau reject ber-alasan; tanpa respons sampai prepare selesai → pengganti + SP + punishment + off (COU-16)",
        "100% fee Quick ke partner; Quick COD ditanggung dulu kurir (COU-17/18); dispatch usulan OPEN-11"
      ]
    }
